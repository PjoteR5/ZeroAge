# Copy this file to `.env` for local development (never commit `.env` to Git)

# Optional FastAPI server URL for `cli.py` (uses automatic in-process ASGI if omitted/offline)
# ZKP_API_URL=http://127.0.0.1:8000

# Optional custom wallet directory (defaults to ~/.zkp_wallet)
# ZKP_WALLET_DIR=~/.zkp_wallet

# Optional persisted Issuer registry file path for standalone Uvicorn mode
# ZKP_ISSUER_STATE_FILE=./.zkp_wallet/issuer_registry.json

# Future Stage 2/3 Database & Deployment Secrets (configure in GitHub Actions / Environments)
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/zeroage_dev
JWT_TTL_SECONDS=900
CHALLENGE_TTL_SECONDS=120
